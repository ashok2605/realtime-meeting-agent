# Copy to .env and fill in. Never commit .env.
RECALL_API_KEY=            # from Recall.ai dashboard (region-scoped)
RECALL_REGION=us-west-2    # us-east-1 | us-west-2 | eu-central-1 | ap-northeast-1
GEMINI_API_KEY=            # Gemini API key (aistudio.google.com)

PUBLIC_BASE_URL=           # tunnel base URL, e.g. https://your-name.ngrok-free.app
NGROK_AUTHTOKEN=           # from dashboard.ngrok.com (free account)
NGROK_DOMAIN=              # your free static domain, e.g. your-name.ngrok-free.app
